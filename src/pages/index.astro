---
import '../styles/global.css';
import BrandHeader from '../components/BrandHeader.astro';
import StoreCard from '../components/StoreCard.astro';
import ShareSheet from '../components/ShareSheet.astro';
import site from '../data/site.json';
import { loadStores } from '../lib/load-stores.ts';
import { storeHref, storeShareUrl } from '../lib/stores.ts';

// Throws (and stops the build) if src/data/stores.json has any problem.
const { stores, warnings } = loadStores();
for (const warning of warnings) console.warn(`[stores] ${warning}`);

const base = import.meta.env.BASE_URL;
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonicalUrl = new URL(base, siteOrigin).href;
const asset = (path: string) => `${base.replace(/\/+$/, '')}/${path}`;
const ogImageUrl = new URL(asset('og-image.jpg'), siteOrigin).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.pageTitle}</title>
    <meta name="description" content={site.metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#fffbeb" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={asset('icon-192.png')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:title" content={site.pageTitle} />
    <meta property="og:description" content={site.metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.brandName} logo`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main class="page">
      <BrandHeader brandName={site.brandName} tagline={site.tagline} />

      <nav class="stores" aria-label={`${site.brandName} store links`}>
        <ul class="stores__list">
          {
            stores.map((store) => (
              <StoreCard
                store={store}
                href={storeHref(store, base)}
                shareUrl={storeShareUrl(store, siteOrigin, base)}
                moreOptionsLabel={site.labels.moreOptions}
              />
            ))
          }
        </ul>
      </nav>

      <footer class="footer">
        <p>© {year} {site.brandName}</p>
      </footer>
    </main>

    <ShareSheet labels={site.labels} />
  </body>
</html>

<style>
  .page {
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-4) var(--space-6);
  }

  .stores {
    margin-top: var(--space-6);
  }

  .stores__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer {
    margin-top: var(--space-7);
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }

  .footer p {
    margin: 0;
  }

  @media (min-width: 768px) {
    .page {
      padding-top: 72px;
    }

    .stores__list {
      gap: 20px;
    }
  }
</style>
