---
import mark from '../assets/brand/mark-288.webp';

interface Props {
  brandName: string;
  tagline: string;
}

const { brandName, tagline } = Astro.props;
const initials = brandName
  .split(/\s+/)
  .map((word) => word.charAt(0))
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<header class="brand">
  <div class="avatar" data-avatar>
    <span class="avatar__fallback" aria-hidden="true">{initials}</span>
    <img
      class="avatar__img"
      src={mark.src}
      width="96"
      height="96"
      alt={`${brandName} logo`}
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <h1 class="brand__name">{brandName}</h1>
  <p class="brand__tagline">{tagline}</p>
  <div class="layers" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
</header>

<script>
  // Show the initials if the logo image cannot be loaded.
  const avatar = document.querySelector<HTMLElement>('[data-avatar]');
  const img = avatar?.querySelector('img');
  if (avatar && img) {
    const markFailed = () => avatar.classList.add('avatar--failed');
    if (img.complete && img.naturalWidth === 0) markFailed();
    else img.addEventListener('error', markFailed, { once: true });
  }
</script>

<style>
  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 3px solid var(--color-ink);
    box-shadow: 0 var(--layer-offset) 0 var(--color-ink);
    overflow: hidden;
  }

  .avatar__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--color-surface);
  }

  .avatar--failed .avatar__img {
    display: none;
  }

  .avatar__fallback {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }

  .brand__name {
    margin: var(--space-5) 0 0;
    font-size: 1.875rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .brand__tagline {
    margin: var(--space-2) 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }

  /* Three stacked bars echoing the layered colours of the logo. */
  .layers {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    margin-top: var(--space-4);
  }

  .layers span {
    display: block;
    height: 4px;
    border-radius: var(--radius-pill);
  }

  .layers span:nth-child(1) {
    width: 56px;
    background: var(--color-layer-yellow);
  }

  .layers span:nth-child(2) {
    width: 44px;
    background: var(--color-layer-orange);
  }

  .layers span:nth-child(3) {
    width: 32px;
    background: var(--color-layer-red);
  }

  @media (min-width: 768px) {
    .avatar {
      width: 120px;
      height: 120px;
    }

    .brand__name {
      font-size: 2.25rem;
    }
  }
</style>
